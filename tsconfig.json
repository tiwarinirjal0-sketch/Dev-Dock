
{
  "compilerOptions": {
    // JavaScript version to generate
    "target": "ES2022",

    // Node.js uses ES modules
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    // Source and compiled files
    "rootDir": "./src",
    "outDir": "./dist",

    // Allow JavaScript and TypeScript together
    "allowJs": true,
    "checkJs": false,

    // Type checking
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Node.js types
    "types": ["node"],

    // Output settings
    "sourceMap": true,

    // Compatibility
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
